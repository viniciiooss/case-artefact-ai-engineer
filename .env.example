# demo roda sem chave e sem chamadas externas. É um simulador determinístico.
EMPORIO_PROVIDER=demo
EMPORIO_STATE_DIR=var
# Para OpenAI: EMPORIO_PROVIDER=openai, defina a chave e escolha o modelo.
# OPENAI_API_KEY=
# EMPORIO_MODEL=gpt-4.1-mini
# Para OpenRouter: EMPORIO_PROVIDER=openrouter, chave separada e modelo com provedor/slug.
# OPENROUTER_API_KEY=
# EMPORIO_MODEL=xiaomi/mimo-v2.5
# EMPORIO_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# EMPORIO_OPENROUTER_SITE_URL=http://127.0.0.1:8000
# Para Ollama: ollama pull qwen3:8b; EMPORIO_PROVIDER=ollama
# EMPORIO_MODEL=qwen3:8b
# EMPORIO_OLLAMA_URL=http://localhost:11434
# Opcional: diretório contendo os seis CSVs e politicas_da_loja.pdf.
# EMPORIO_DATA_DIR=data
EMPORIO_MAX_TOOL_ROUNDS=4
EMPORIO_LLM_TIMEOUT=45

# Langfuse: instale o extra observability e habilite com chaves do seu projeto.
EMPORIO_LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
EMPORIO_LANGFUSE_ENVIRONMENT=artefact-local

# Juiz DeepEval via OpenRouter; só é chamado por scripts/evaluate_llm.py (extra eval).
EMPORIO_EVAL_MODEL=openai/gpt-4.1-mini
